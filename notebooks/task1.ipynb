    "print(f\"  {_status}  All tokens are lowercase\")\n",
    "# --- 3. No tokens shorter than 2 characters -----------------------------------\n",
    "short_tokens = [(i, w) for i, r in enumerate(tk_reviews) for w in r if len(w) < 2]\n",
