   "source": [
    "### 6) Tokenization function"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "metadata": {},
   "outputs": [],
   "source": [
    "import re\n",
    "\n",
    "# Convert text to lowercase and split into words (unigrams)\n",
    "def tokenize(text):\n",
    "    text = text.lower()\n",
    "    tokens = re.findall(r\"\\b\\w+\\b\", text)\n",
    "    return tokens"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 7) Load glove embedding"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "\n",
    "# Load pretrained GloVe embeddings into a dictionary\n",
    "def load_glove(file_path):\n",
    "    embeddings = {}\n",
    "    with open(file_path, encoding=\"utf8\") as f:\n",
    "        for line in f:\n",
    "            values = line.split()\n",
    "            word = values[0]\n",
    "            vector = np.asarray(values[1:], dtype=\"float32\")\n",
    "            embeddings[word] = vector\n",
    "    return embeddings\n",
    "\n",
    "# Load embedding file (adjust path if needed)\n",
    "glove = load_glove(\"glove.6B.300d.txt\")\n",
    "embedding_dim = 300   # Dimension of GloVe vectors"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 8) Unweighted Embedding (average word vectors)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "First 3 lines preview:\n",
      "#0,0.14781442,0.2877383,-0.06825671,0.116026424,-0.29140028,-0.09207285,-0.101884425,0.005842856,0.036033135,-1.06034,-0.032156426,-0.010611714,-0.08491143,0.13720787,0.021288285,0.033463996,0.24081056,0.19038545,-0.1800\n",
      "#1,0.28390434,0.18822001,-0.12652099,0.03229566,-0.13382,-0.25946462,0.21344233,0.14592,0.15187,-1.3331333,0.092378326,-0.34473166,-0.13787667,0.29270932,0.155208,0.012526661,-0.07127201,0.13216,-0.0061494657,0.32001665,\n",
      "#2,-0.014847372,-0.047925875,0.11234374,-0.070048496,-0.15965582,-0.08127776,0.034084987,0.14645125,0.10687161,-0.91616243,-0.021377282,-0.14732046,-0.14999865,0.083502494,-0.1076965,-0.13386838,-0.1539625,0.11383775,-0.\n"
     ]
    }
   ],
   "source": [
    "unweighted_vectors = []\n",
    "\n",
    "for i, review in enumerate(reviews):\n",
    "    tokens = tokenize(review)\n",
    "    \n",
    "    # Collect embedding vectors for words present in GloVe\n",
    "    vectors = [glove[word] for word in tokens if word in glove]\n",
    "    \n",
    "    # Compute average vector (if no words found → zero vector)\n",
    "    if len(vectors) > 0:\n",
    "        avg_vec = np.mean(vectors, axis=0)\n",
    "    else:\n",
    "        avg_vec = np.zeros(embedding_dim)\n",
    "    \n",
    "    # Format output line\n",
    "    line = f\"#{i},\" + \",\".join(map(str, avg_vec))\n",
    "    unweighted_vectors.append(line)\n",
    "\n",
    "# Unweighted vectors preview\n",
    "print(\"First 3 lines preview:\")\n",
    "for line in unweighted_vectors[:3]:\n",
    "    print(line[:220])"
   ]
