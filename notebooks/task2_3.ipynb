    "df_q2 = pd.read_csv(DATA_PATH).copy()\n",
    "\n",
    "# Fill missing text columns with empty strings so the vectorizers don't crash\n",
    "text_columns = [\"review_text\", \"review_title\", \"product_title\", \"brand_name\"]\n",
    "for col in text_columns:\n",
