   "source": [
    "### 10) TF-IDF Weighted Embedding"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "#### Step 1: Compute TF-IDF"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 32,
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "c:\\Users\\Admin\\AppData\\Local\\Python\\pythoncore-3.14-64\\Lib\\site-packages\\sklearn\\feature_extraction\\text.py:526: UserWarning: The parameter 'token_pattern' will not be used since 'tokenizer' is not None'\n",
      "  warnings.warn(\n"
     ]
    }
   ],
   "source": [
    "from sklearn.feature_extraction.text import TfidfVectorizer\n",
    "\n",
    "# Learn TF-IDF weights from all reviews\n",
    "vectorizer = TfidfVectorizer(tokenizer=tokenize, lowercase=True)\n",
    "tfidf_matrix = vectorizer.fit_transform(reviews)\n",
    "\n",
    "# Map each word to its column index in TF-IDF matrix\n",
    "feature_names = vectorizer.get_feature_names_out()\n",
    "word_index = {word: i for i, word in enumerate(feature_names)}"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "#### Step 2: Build weighted vectors"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "weighted_vectors = []\n",
    "\n",
    "for i, review in enumerate(reviews):\n",
    "    tokens = tokenize(review)\n",
    "    \n",
    "    vec = np.zeros(embedding_dim)   # Initialize vector\n",
    "    total_weight = 0                # Track total TF-IDF weight\n",
    "    \n",
    "    for word in tokens:\n",
    "        # Only use words present in both GloVe and TF-IDF vocab\n",
    "        if word in glove and word in word_index:\n",
    "            tfidf_weight = tfidf_matrix[i, word_index[word]]\n",
    "            vec += glove[word] * tfidf_weight   # Weighted sum\n",
    "            total_weight += tfidf_weight\n",
    "    \n",
    "    # Normalize by total weight (avoid bias to long reviews)\n",
    "    if total_weight > 0:\n",
    "        vec = vec / total_weight\n",
    "    \n",
    "    # Format output line\n",
    "    line = f\"#{i},\" + \",\".join(map(str, vec))\n",
    "    weighted_vectors.append(line)\n",
    "\n",
    "# Weighted vectors preview\n",
    "print(\"First 3 lines preview:\")\n",
    "for line in weighted_vectors[:3]:\n",
    "    print(line[:220])"
   ]
  },
